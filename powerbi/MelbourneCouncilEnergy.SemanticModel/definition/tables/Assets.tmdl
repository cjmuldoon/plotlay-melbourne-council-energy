table Assets
	lineageTag: 9aedeaf1-f77b-8642-abe5-28503b8c5de8

	/// The one measure the usage is for: the one picked, or Electricity when none is
	measure 'Measure shown' = IF ( HASONEVALUE ( Measures[measure] ), VALUES ( Measures[measure] ), "Electricity" )
		lineageTag: b425877a-e146-49d1-96bf-7964534413c2

	/// The usage of one measure (electricity kWh, gas MJ or water kL): the one picked, or electricity. Measures are never added together. The whole year unless a month is picked
	measure Amount =
			VAR m = [Measure shown]
			RETURN CALCULATE ( SUM ( Usage[amount] ), Measures[measure] = m )
		formatString: #,0
		lineageTag: 5c264d98-1b71-9ca3-e044-6b6cb6882c34

	measure Unit = LOOKUPVALUE ( Measures[unit], Measures[measure], [Measure shown] )
		lineageTag: 247c3a12-4bbf-1bcb-5cfb-522081be4d09

	measure 'Electricity kWh' = CALCULATE ( SUM ( Usage[amount] ), Measures[measure] = "Electricity" )
		formatString: #,0
		displayFolder: By measure
		lineageTag: a8c4c3ed-7f32-5905-8cf9-6297e852776e

	measure 'Gas MJ' = CALCULATE ( SUM ( Usage[amount] ), Measures[measure] = "Gas" )
		formatString: #,0
		displayFolder: By measure
		lineageTag: d3b6267d-cdb0-6ff9-be62-b6760205f183

	measure 'Water kL' = CALCULATE ( SUM ( Usage[amount] ), Measures[measure] = "Water" )
		formatString: #,0
		displayFolder: By measure
		lineageTag: 94a33ed3-941a-7ca8-3138-5fc1fa049eeb

	/// The shape area from Plotlay (parcel or 2023 footprint)
	measure 'Area m2' = SUM ( Assets[area_m2] )
		formatString: #,0
		displayFolder: Per area
		lineageTag: 32284125-9a79-01b3-eff3-9d609e378754

	/// Footprint x floors above ground (CLUE 2014): an estimate
	measure 'Floor m2 estimated' = SUM ( Assets[floor_m2_est] )
		formatString: #,0
		displayFolder: Per area
		lineageTag: 8604ac86-13f0-f607-23cf-022686bc59eb

	/// Grid electricity over estimated floor area
	measure 'kWh per m2 floor' = DIVIDE ( [Electricity kWh], [Floor m2 estimated] )
		formatString: #,0
		displayFolder: Per area
		lineageTag: 566dbb19-71ef-a2cc-bd2b-699a9b9e4db3

	/// Water as a depth over the council parcel, parcels only
	measure 'Water mm' = DIVIDE ( CALCULATE ( [Water kL], Assets[property_id] > 0 ), CALCULATE ( [Area m2], Assets[property_id] > 0 ) ) * 1000
		formatString: #,0
		displayFolder: Per area
		lineageTag: a254f192-1100-1733-1ffb-dac3deaf6dff

	/// December to February over June to August
	measure 'Water summer over winter' = DIVIDE ( CALCULATE ( [Water kL], Months[season] = "Summer" ), CALCULATE ( [Water kL], Months[season] = "Winter" ) )
		formatString: 0.0
		displayFolder: Season
		lineageTag: 2303faf4-a9b8-1b3c-b55b-b2f670e1088a

	measure 'Assets placed' = CALCULATE ( COUNTROWS ( Assets ), Assets[placed] = TRUE () )
		formatString: 0
		displayFolder: Mapping
		lineageTag: 11eb0ccd-fada-3e90-6a8c-a85c4559ce5a

	measure 'Assets with no register location' = CALCULATE ( COUNTROWS ( Assets ), Assets[register_position] IN { "none", "not in register" } )
		formatString: 0
		displayFolder: Mapping
		lineageTag: 5a3bfe63-070d-4f79-012b-39ea36df29c4

	/// Drill-through page title
	measure 'Asset title' = SELECTEDVALUE ( Assets[asset_name], "Pick an asset" ) & ", " & SELECTEDVALUE ( Assets[address], "" )
		lineageTag: 7b4cfda8-5a76-0a19-b969-a3607ff24d9c

