	partition Assets = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("assets/assets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"asset_name", "asset_type", "category", "address", "suburb", "register_position", "placed", "shape_basis", "source", "structure_id", "property_id", "parts", "area_m2", "length_m", "floors", "floor_m2_est", "water_mm", "centroid_lat", "centroid_lng", "electricity_days_billed", "water_days_billed", "shape_note"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"asset_name", type text}, {"asset_type", type text}, {"category", type text}, {"address", type text}, {"suburb", type text}, {"register_position", type text}, {"placed", type logical}, {"shape_basis", type text}, {"source", type text}, {"structure_id", type text}, {"property_id", type number}, {"parts", type number}, {"area_m2", type number}, {"length_m", type number}, {"floors", type number}, {"floor_m2_est", type number}, {"water_mm", type number}, {"centroid_lat", type number}, {"centroid_lng", type number}, {"electricity_days_billed", type number}, {"water_days_billed", type number}, {"shape_note", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
